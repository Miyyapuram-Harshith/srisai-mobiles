{
  "name": "srisai-mobiles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && wrangler pages functions build --outdir dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --live-reload",
    "pages:build": "npm run build",
    "deploy": "wrangler deploy --yes",
    "db:migrate:local": "wrangler d1 migrations apply srisai_db_dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply srisai_db_dev --remote",
    "db:seed:local": "wrangler d1 execute srisai_db_dev --local --file=./db/seed/0001_initial_data.sql && wrangler d1 execute srisai_db_dev --local --file=./db/seed/0002_categories.sql"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.145.0"
  }
}
